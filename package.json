{
  "name": "qa-automation-demo",
  "version": "1.0.0",
  "description": "Demo kickstarter project untuk belajar Playwright sebelum implementasi ke environment kerja nyata (dev/staging/prod, API core/back office/end user app)",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:backoffice": "playwright test --project=backoffice",
    "test:app": "playwright test --project=app",
    "test:unit": "playwright test --project=unit",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "report:pdf": "tsx scripts/generate-pdf-report.ts",
    "test:report": "playwright test && allure generate allure-results --clean && allure open"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "allure": "^3.14.3",
    "allure-playwright": "^3.10.2",
    "tsx": "^4.23.1"
  }
}
